{
  "name": "speedrun-ghosts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run level:check && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "level:generate": "tsx scripts/generate-level.ts",
    "level:check": "tsx scripts/check-level-sync.ts",
    "security:check": "tsx scripts/check-no-secrets.ts",
